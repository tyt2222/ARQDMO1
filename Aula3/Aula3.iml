local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoidRootPart = newChar:WaitForChild("HumanoidRootPart")
end)

local DISTANCIA_MINIMA = 10
local DISTANCIA_DIVE = 22
local COOLDOWN_AUTO_M1 = 0.5
local COOLDOWN_AUTO_DIVE = 1.5

local TEMPO_ANTECIPACAO_M1 = 0.15
local TEMPO_ANTECIPACAO_DIVE = 0.4
local MAX_ALTURA_DIVE = 1.5

local debounceList = setmetatable({}, {__mode = "k"})
local ballHistory = setmetatable({}, {__mode = "k"})
local ativo = true
local autoM1Ativo = false
local autoDiveAtivo = false
local filtroQuadraAtivo = false
local DEBUG = true

