toggleButton.MouseButton1Click:Connect(function()
    ativo = not ativo
    if ativo then
        toggleButton.Text = "SCRIPT: ATIVADO"
        toggleButton.BackgroundColor3 = Color3.fromRGB(40, 160, 70)
    else
        toggleButton.Text = "SCRIPT: DESATIVADO"
        toggleButton.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
        statusLabel.Text = "Nenhuma bola por perto"
        statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end)

