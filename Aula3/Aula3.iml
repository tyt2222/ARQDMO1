local heartbeatConnection

deleteButton.MouseButton1Click:Connect(function()
    if heartbeatConnection then
        heartbeatConnection:Disconnect()
    end
    screenGui:Destroy()
    if typeof(script) == "Instance" then
        pcall(function() script:Destroy() end)
    end
end)

local function clicarM1()
    task.spawn(function()
        if mouse1click then
            mouse1click()
        else
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.03)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end
    end)
end

local function lookAtAndDive(targetPos)
    task.spawn(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if humanoidRootPart and humanoid then
            local hrpPos = humanoidRootPart.Position
            local targetHorizontal = Vector3.new(targetPos.X, hrpPos.Y, targetPos.Z)
            
            humanoidRootPart.CFrame = CFrame.lookAt(hrpPos, targetHorizontal)
            
            local direction = (targetHorizontal - hrpPos).Unit
            humanoid:Move(direction, false)
        end
        
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
    end)
end

local function getBallPosition(ball)
    local part = ball:FindFirstChild("Volleyball")
    if part and part:IsA("BasePart") then
        return part.Position
    end
    local ok, pivot = pcall(function() return ball:GetPivot() end)
    if ok and pivot then
        return pivot.Position
    end
    return nil
end

local function isPointInsidePart(point, part)
    local localPos = part.CFrame:PointToObjectSpace(point)
    local halfSize = part.Size / 2
    return math.abs(localPos.X) <= halfSize.X 
       and math.abs(localPos.Y) <= halfSize.Y 
       and math.abs(localPos.Z) <= halfSize.Z
end

local function isPointInCourt(point)
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") and (obj.Name == "BR" or obj.Name == "BackrowLF") then
            local localPos = obj.CFrame:PointToObjectSpace(point)
            local halfSize = obj.Size / 2
            
            if math.abs(localPos.X) <= halfSize.X and math.abs(localPos.Z) <= halfSize.Z then
                if localPos.Y >= -10 and localPos.Y <= 100 then
                    return true
                end
            end
        end
    end
    return false
end

local cvrFolder = workspace:WaitForChild("CVR", 5)
local lastDebugPrint = 0

heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
    if not ativo or not humanoidRootPart or not humanoidRootPart.Parent or not cvrFolder then
        return
    end

    local recHitbox = character:FindFirstChild("RecHitbox")
    local bolaPerto = false
    local children = cvrFolder:GetChildren()
    local showDebug = DEBUG and (os.clock() - lastDebugPrint >= 1)

    if showDebug then
        lastDebugPrint = os.clock()
    end

    for _, ball in ipairs(children) do
        local ballPos = getBallPosition(ball)
        
        if ballPos then
            if filtroQuadraAtivo and not isPointInCourt(ballPos) then
                continue
            end

            local lastPos = ballHistory[ball]
            local velocity = Vector3.zero
            
            if lastPos then
                velocity = (ballPos - lastPos) / dt
            end
            
            ballHistory[ball] = ballPos
            
            local posFuturaM1 = ballPos + (velocity * TEMPO_ANTECIPACAO_M1)
            local posFuturaDive = ballPos + (velocity * TEMPO_ANTECIPACAO_DIVE)
            
            local distanciaAtual = (humanoidRootPart.Position - ballPos).Magnitude
            local distanciaFuturaM1 = (humanoidRootPart.Position - posFuturaM1).Magnitude
            local distanciaFuturaDive = (humanoidRootPart.Position - posFuturaDive).Magnitude

            if distanciaFuturaM1 <= distanciaAtual or distanciaFuturaDive <= distanciaAtual then
                local inRecRange = false
                local inDiveRange = false

                if recHitbox and recHitbox:IsA("BasePart") then
                    inRecRange = isPointInsidePart(posFuturaM1, recHitbox)
                else
                    inRecRange = (distanciaFuturaM1 <= DISTANCIA_MINIMA)
                end

                if not inRecRange and distanciaFuturaDive <= DISTANCIA_DIVE then
                    local alturaRelativa = posFuturaDive.Y - humanoidRootPart.Position.Y
                    if alturaRelativa <= MAX_ALTURA_DIVE then
                        inDiveRange = true
                    end
                end

                if inRecRange and autoM1Ativo then
                    bolaPerto = true
                    if not debounceList[ball] then
                        debounceList[ball] = true
                        clicarM1()
                        task.delay(COOLDOWN_AUTO_M1, function() debounceList[ball] = nil end)
                    end
                elseif inDiveRange and autoDiveAtivo then
                    bolaPerto = true
                    if not debounceList[ball] then
                        debounceList[ball] = true
                        lookAtAndDive(posFuturaDive)
                        task.delay(COOLDOWN_AUTO_DIVE, function() debounceList[ball] = nil end)
                    end
                end
            end
        end
    end

    if bolaPerto then
        statusLabel.Text = "⚠ Bola detectada!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
    else
        statusLabel.Text = "Nenhuma bola por perto"
        statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end)